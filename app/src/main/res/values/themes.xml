<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Lab4" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Splash: no action bar, branded bg -->
    <style name="Theme.Lab4.Splash" parent="Theme.Lab4">
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.Lab4.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="elevation">@dimen/elevation_md</item>
    </style>

    <style name="Widget.Lab4.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_md</item>
    </style>

    <style name="Widget.Lab4.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <!-- TextAppearance — explicit parents required so AAPT can resolve the chain -->
    <style name="TextAppearance.Lab4.Hero"
        parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Lab4.Title"
        parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Lab4.Price"
        parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Lab4.Section"
        parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
